    // Dedicated Seller Accounts: isolated from Customer Accounts; sellers cannot self-approve or escalate role or verifiedBadge
    match /sellers/{sellerId} {
      allow read: if isStaffAdmin() || (isSignedIn() && request.auth.uid == sellerId && resource.data.role == "seller");
      allow create: if isStaffAdmin() || (
        isSignedIn() &&
        request.auth.uid == sellerId &&
        request.resource.data.role == "seller" &&
        request.resource.data.status == "pending" &&
        request.resource.data.kycVerified == false &&
        (!('verifiedBadge' in request.resource.data) || request.resource.data.verifiedBadge == false)
      );
      allow update: if isStaffAdmin() || (
        isSignedIn() &&
        request.auth.uid == sellerId &&
        resource.data.role == "seller" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.kycVerified == resource.data.kycVerified &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'kycVerified', 'verifiedBadge', 'permissions', 'walletBalance', 'totalEarnings']) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['not_submitted', 'pending_admin_review'])
      );
      allow delete: if isStaffAdmin();
    }

    // Dedicated Customer Accounts: isolated from Seller Accounts; customers cannot escalate role to seller or admin
    match /users/{userId} {
      allow read: if isStaffAdmin() || (isSignedIn() && request.auth.uid == userId && resource.data.role == "customer");
      allow create: if isStaffAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == "customer"
      );
      allow update: if isStaffAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == "customer" &&
        request.resource.data.role == "customer" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked'])
      );
      allow delete: if isStaffAdmin();
    }
